    <item>
      <title>test item</title>
      <enclosure url="http://169.254.169.254/computeMetadata/v1/instance/hostname" type="audio/mpeg" length="1000"/>
      <itunes:image href="http://metadata.google.internal/computeMetadata/v1/instance/hostname"/>
